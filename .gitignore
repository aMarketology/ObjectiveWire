# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-main/
/.next-org/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Allow the example template — it has no real secrets
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# migration backups (written by wiki:trim, never commit)
*.bak

# supabase
.branches
.temp
.vscode
supabase/.temp
supabase/functions/.vscode

# Google service account credential files — NEVER commit these
*-[a-f0-9]*.json
objectwireorg-76d014b98819.json

# registry-data.json is generated at build time by sync-registry.ts
# Never commit — each environment regenerates it from its own page.tsx files.
lib/registry-data.json

# Site-specific registries ARE committed — they are the source of truth for
# each deployment (objectivewire.com vs objectivewire.org) and must exist in
# the repo so `next dev` can serve both sites without a prebuild step.
!lib/registry-data-main.json
!lib/registry-data-org.json

